{
  "$defs": {
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_port": {
          "title": "Source Port",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "target_port": {
          "title": "Target Port",
          "type": "string"
        },
        "kind": {
          "default": "data",
          "enum": [
            "data",
            "control",
            "import",
            "contains"
          ],
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "default": "UNVERIFIED",
          "enum": [
            "STATIC_INFERRED",
            "UNVERIFIED",
            "DECLARED",
            "RUN_OBSERVED"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "source",
        "source_port",
        "target",
        "target_port"
      ],
      "title": "Edge",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "line": {
          "default": 1,
          "minimum": 1,
          "title": "Line",
          "type": "integer"
        },
        "sha256": {
          "default": "",
          "title": "Sha256",
          "type": "string"
        },
        "status": {
          "default": "STATIC_INFERRED",
          "enum": [
            "STATIC_INFERRED",
            "UNVERIFIED",
            "DECLARED",
            "RUN_OBSERVED"
          ],
          "title": "Status",
          "type": "string"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Graph": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "maxItems": 6000,
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "maxItems": 20000,
          "title": "Edges",
          "type": "array"
        }
      },
      "title": "Graph",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "default": "module",
          "title": "Kind",
          "type": "string"
        },
        "parent": {
          "default": "",
          "title": "Parent",
          "type": "string"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/Port"
          },
          "title": "Ports",
          "type": "array"
        },
        "parameters": {
          "title": "Parameters",
          "type": "object"
        },
        "position": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Position",
          "type": "object"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Node",
      "type": "object"
    },
    "Port": {
      "additionalProperties": false,
