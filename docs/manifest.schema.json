        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "io": {
          "enum": [
            "input",
            "output"
          ],
          "title": "Io",
          "type": "string"
        },
        "data_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Type"
        },
        "schema_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Ref"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "multiplicity": {
          "default": "many",
          "enum": [
            "one",
            "many"
          ],
          "title": "Multiplicity",
          "type": "string"
        },
        "semantics": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Semantics",
          "type": "object"
        },
        "description": {
          "default": "未知类型需人工确认；静态关系不代表实际执行。",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "id",
        "io"
      ],
      "title": "Port",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "1",
