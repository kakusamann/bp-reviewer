      "enum": [
        "1"
      ],
      "title": "Version",
      "type": "string"
    },
    "graph": {
      "$ref": "#/$defs/Graph"
    },
    "require_dag": {
      "default": true,
      "title": "Require Dag",
      "type": "boolean"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    }
  },
  "required": [
    "graph"
  ],
  "title": "Manifest",
  "type": "object"
}
