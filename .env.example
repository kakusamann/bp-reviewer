# MiMo OpenAI-compatible API configuration.
# Copy this file to .env and fill in your own API key.
# Never commit .env or paste the key into the frontend.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# Token/cost guardrails: only ranked core files are sent to MiMo.
MIMO_MAX_ANALYSIS_FILES=8
MIMO_MAX_FILE_CHARS=3500
MIMO_MAX_TOTAL_CHARS=22000

# Lower budget for each recursive/local subtree build.
MIMO_MAX_SCOPED_ANALYSIS_FILES=4
MIMO_MAX_SCOPED_TOTAL_CHARS=12000

# Functional areas are discovered from the project: there is no fixed number to configure.
# Each area's analysis still uses the per-call token/file budgets above.

# Evidence agent: optional bounded MiMo Function Calling (falls back to AST facts).
MIMO_ENABLE_TOOL_CALLING=true
